10 REM ***** KAZUATE GAME *****
20 CLS : SPEED 4000 :WIDTH 40
30 PRINT "*** KAZUATE GAME ***"
40 PRINT "1 KARA 100 NO KAZU WO ATETE NE"
50 RANDOMIZE
60 X=INT(RND(1)*100)+1
70 T=0
80 T=T+1
90 INPUT "KAZU WA";A
100 IF A=X THEN 130
110 IF A<X THEN PRINT "MOTTO OOKII YO" ELSE PRINT "MOTTO CHIISAI YO"
120 GOTO 80
130 BEEP
140 PRINT "ATARI !! ";T;"KAI DE SEIKAI"
150 INPUT "MOU ICHIDO (Y/N)";A$
160 IF A$="Y" OR A$="y" THEN 60
170 PRINT "MATA ASOBOU NE!"
180 END
