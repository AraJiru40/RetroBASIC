10 ' MYSTERY ROOM - A SMALL GRAPHIC ADVENTURE
20 WIDTH 40:COLOR 7,0:CLS 3:SPEED 4000
30 W$=HEXCHR$("AAFFFF 55FFFF")
40 F$=HEXCHR$("880000 220000")
50 T$=HEXCHR$("00AA22 005544")
60 P$=HEXCHR$("AAAA00 555500")
70 D=0:K=0:U=0:O=0
80 M1$="YOU ARE IN A SMALL ROOM.":M2$="TYPE HELP FOR COMMANDS."
100 GOSUB 1000
110 LOCATE 0,18:PRINT S1$
120 LOCATE 0,19:PRINT S2$
130 LOCATE 0,21:PRINT M1$
140 LOCATE 0,22:PRINT M2$
150 LOCATE 0,24:LINE INPUT "> ";C$
160 GOSUB 700
170 M1$="I DO NOT UNDERSTAND.":M2$="TYPE HELP FOR COMMANDS."
200 IF C$="NORTH" THEN D=0:M1$="YOU FACE NORTH.":M2$="":GOTO 100
210 IF C$="EAST" THEN D=1:M1$="YOU FACE EAST.":M2$="":GOTO 100
220 IF C$="SOUTH" THEN D=2:M1$="YOU FACE SOUTH.":M2$="":GOTO 100
230 IF C$="WEST" THEN D=3:M1$="YOU FACE WEST.":M2$="":GOTO 100
240 IF C$="LOOK" OR C$="LOOK ROOM" THEN M1$="YOU LOOK AROUND.":M2$="":GOTO 100
250 IF C$="LOOK WINDOW" THEN GOTO 400
260 IF C$="LOOK DOOR" THEN GOTO 430
270 IF C$="LOOK DESK" OR C$="LOOK TABLE" THEN GOTO 470
280 IF C$="LOOK KEY" THEN GOTO 510
290 IF C$="TAKE" OR C$="GET" THEN M1$="TAKE WHAT?":M2$="":GOTO 100
300 IF C$="TAKE KEY" OR C$="GET KEY" THEN GOTO 540
310 IF C$="UNLOCK" THEN M1$="UNLOCK WHAT?":M2$="":GOTO 100
320 IF C$="UNLOCK DOOR" OR C$="USE KEY" THEN GOTO 580
330 IF C$="OPEN" THEN M1$="OPEN WHAT?":M2$="":GOTO 100
340 IF C$="OPEN DOOR" THEN GOTO 630
350 IF C$="INVENTORY" OR C$="I" THEN GOTO 670
360 IF C$="HELP" THEN M1$="NORTH EAST SOUTH WEST LOOK":M2$="TAKE KEY  UNLOCK DOOR  OPEN DOOR":GOTO 100
370 IF C$="QUIT" THEN CLS 3:PRINT "GOODBYE.":END
380 GOTO 100
400 IF D=0 OR D=3 THEN M1$="THE WINDOW IS SHUT.":M2$="IT IS DARK OUTSIDE.":GOTO 100
410 M1$="YOU CANNOT SEE A WINDOW HERE.":M2$="":GOTO 100
430 IF D<>1 THEN M1$="YOU CANNOT SEE THE DOOR HERE.":M2$="":GOTO 100
440 IF U=0 THEN M1$="A STRONG DOOR. IT IS LOCKED.":M2$="":GOTO 100
450 M1$="A STRONG DOOR. IT IS UNLOCKED.":M2$="":GOTO 100
470 IF D<>2 THEN M1$="YOU CANNOT SEE THE DESK HERE.":M2$="":GOTO 100
480 IF K=0 THEN M1$="A BROWN WOODEN DESK.":M2$="A SMALL KEY IS ON IT.":GOTO 100
490 M1$="A BROWN WOODEN DESK.":M2$="IT IS EMPTY.":GOTO 100
510 IF K=1 THEN M1$="YOU HAVE A SMALL YELLOW KEY.":M2$="":GOTO 100
520 IF D=2 THEN M1$="A SMALL YELLOW KEY.":M2$="IT IS ON THE DESK.":GOTO 100
530 M1$="YOU CANNOT SEE A KEY HERE.":M2$="":GOTO 100
540 IF K=1 THEN M1$="YOU ALREADY HAVE THE KEY.":M2$="":GOTO 100
550 IF D<>2 THEN M1$="YOU CANNOT REACH THE KEY HERE.":M2$="FACE SOUTH AND TRY AGAIN.":GOTO 100
560 K=1:BEEP:M1$="TAKEN.":M2$="YOU HAVE THE KEY.":GOTO 100
580 IF D<>1 THEN M1$="THE DOOR IS NOT HERE.":M2$="FACE EAST AND TRY AGAIN.":GOTO 100
590 IF U=1 THEN M1$="THE DOOR IS ALREADY UNLOCKED.":M2$="":GOTO 100
600 IF K=0 THEN M1$="YOU NEED A KEY.":M2$="":GOTO 100
610 U=1:BEEP:M1$="CLICK! THE DOOR IS UNLOCKED.":M2$="":GOTO 100
630 IF D<>1 THEN M1$="THE DOOR IS NOT HERE.":M2$="FACE EAST AND TRY AGAIN.":GOTO 100
640 IF U=0 THEN M1$="THE DOOR IS LOCKED.":M2$="":GOTO 100
650 O=1:GOTO 5000
670 IF K=1 THEN M1$="YOU HAVE A SMALL YELLOW KEY.":M2$="":GOTO 100
680 M1$="YOU HAVE NOTHING.":M2$="":GOTO 100
700 N$=""
710 FOR J=1 TO LEN(C$)
720 H$=MID$(C$,J,1):A=ASC(H$)
730 IF A>=97 AND A<=122 THEN H$=CHR$(A-32)
740 IF H$<>" " THEN N$=N$+H$:GOTO 780
750 IF N$="" THEN GOTO 780
760 IF RIGHT$(N$,1)=" " THEN GOTO 780
770 N$=N$+" "
780 NEXT J
790 IF N$<>"" THEN IF RIGHT$(N$,1)=" " THEN N$=LEFT$(N$,LEN(N$)-1)
800 C$=N$:RETURN
1000 CLS 1:CLS 2
1010 LINE (0,0)-(319,143),7,B
1020 LINE (48,18)-(271,105),7,B
1030 LINE (0,0)-(48,18),7:LINE (319,0)-(271,18),7
1040 LINE (0,143)-(48,105),7:LINE (319,143)-(271,105),7
1050 PAINT (10,5),W$,7:PAINT (10,60),W$,7
1060 PAINT (310,60),W$,7:PAINT (60,30),W$,7
1070 PAINT (160,130),F$,7
1080 ON D+1 GOSUB 2000,2200,2400,2600
1090 RETURN
2000 LINE (104,32)-(215,91),0,B
2010 PAINT (110,38),1,0
2020 LINE (159,32)-(159,91),7:LINE (104,61)-(215,61),7
2030 CIRCLE (184,48),5,7:PAINT (184,48),7,7
2040 S1$="A WINDOW IS ON THE NORTH WALL."
2050 S2$="IT IS DARK OUTSIDE.":RETURN
2200 IF O=1 THEN GOTO 2300
2210 LINE (105,23)-(215,105),0,B
2220 PAINT (110,30),P$,0
2230 LINE (119,38)-(201,91),7,B
2240 CIRCLE (196,68),4,6:PAINT (196,68),6,6
2250 S1$="A DARK PURPLE DOOR IS TO THE EAST."
2260 IF U=0 THEN S2$="THE DOOR IS LOCKED.":RETURN
2270 S2$="THE DOOR IS UNLOCKED.":RETURN
2300 LINE (105,23)-(215,105),0,B:PAINT (110,30),0,0
2310 LINE (215,23)-(260,36),0:LINE (260,36)-(260,96),0
2320 LINE (260,96)-(215,105),0:LINE (215,105)-(215,23),0
2330 PAINT (240,50),P$,0
2340 CIRCLE (225,68),4,6:PAINT (225,68),6,6
2350 S1$="THE DOOR IS OPEN.":S2$="LIGHT SHINES IN.":RETURN
2400 LINE (75,58)-(245,78),0,B:PAINT (80,64),T$,0
2410 LINE (89,78)-(111,120),0,B:PAINT (95,85),T$,0
2420 LINE (209,78)-(231,120),0,B:PAINT (215,85),T$,0
2430 IF K=1 THEN GOTO 2470
2440 CIRCLE (158,67),4,6:PAINT (158,67),6,6
2450 LINE (162,67)-(181,67),6:LINE (174,67)-(174,73),6
2460 LINE (180,67)-(180,71),6
2470 S1$="A BROWN WOODEN DESK IS TO THE SOUTH."
2480 IF K=0 THEN S2$="A SMALL YELLOW KEY IS ON IT.":RETURN
2490 S2$="THE DESK IS EMPTY.":RETURN
2600 LINE (104,32)-(215,91),0,B
2610 PAINT (110,38),1,0
2620 LINE (159,32)-(159,91),7:LINE (104,61)-(215,61),7
2630 LINE (120,78)-(145,55),7:LINE (198,82)-(174,50),7
2640 S1$="A WINDOW IS ON THE WEST WALL."
2650 S2$="OLD VINES COVER THE GLASS.":RETURN
5000 GOSUB 1000
5010 LOCATE 0,18:PRINT "THE DOOR SWINGS OPEN."
5020 LOCATE 0,20:COLOR 6:PRINT "*** YOU ESCAPED! ***":COLOR 7
5030 LOCATE 0,22:PRINT "MYSTERY ROOM COMPLETE."
5040 BEEP:BEEP:BEEP
5050 END
