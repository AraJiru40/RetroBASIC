10 REM ***** UFO CATCH ***** (LEFT/RIGHT ARROW KEYS)
20 WIDTH 40:CLS
30 P=20: SC=0: MISS=0
40 FX=INT(RND(1)*36)+2: FY=0
50 REM --- MAIN LOOP ---
60 K$=INKEY$
70 IF K$="" THEN 110
80 IF K$=CHR$(29) AND P>1 THEN P=P-2
90 IF K$=CHR$(28) AND P<35 THEN P=P+2
100 GOTO 60
110 LOCATE FX,FY: PRINT " ";
120 FY=FY+1
130 IF FY>22 THEN GOSUB 300: GOTO 40
140 LOCATE FX,FY: COLOR 6: PRINT "@";
150 LOCATE 0,23: PRINT SPACE$(79);
160 LOCATE P,23: COLOR 5: PRINT "<=>";
170 LOCATE 0,0: COLOR 7
180 PRINT "SCORE:";SC;"  MISS:";MISS;"  ";
190 FOR W=1 TO 250: NEXT W
200 IF MISS<3 THEN 60
210 LOCATE 15,12: COLOR 2: PRINT "GAME OVER"
220 LOCATE 15,14: COLOR 7: PRINT "SCORE:";SC
230 LOCATE 0,20
240 END
300 REM --- LANDED ---
310 IF FX>=P-1 AND FX<=P+3 THEN SC=SC+10: BEEP ELSE MISS=MISS+1
320 LOCATE FX,FY: PRINT " ";
330 RETURN
