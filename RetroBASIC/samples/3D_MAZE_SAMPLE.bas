10 WIDTH 40:COLOR 7,0:CLS:RANDOMIZE
20 DIM C(7,7),V(7,7),SX(63),SY(63),Q(4)
30 DIM L(3),R(3),T(3),B(3)
40 L(0)=8:R(0)=311:T(0)=10:B(0)=169
50 L(1)=55:R(1)=264:T(1)=40:B(1)=139
60 L(2)=103:R(2)=216:T(2)=63:B(2)=116
70 L(3)=137:R(3)=182:T(3)=80:B(3)=99
80 GOSUB 2000
90 PX=0:PY=0:D=1:M=0
100 GOSUB 1000
110 A$=INKEY$:IF A$="" THEN 110
120 IF A$=" " THEN M=1-M:GOSUB 3000:GOTO 110
130 IF M=1 THEN 110
140 IF A$=CHR$(29) THEN D=(D+3) MOD 4:BEEP:GOSUB 1000:GOTO 110
150 IF A$=CHR$(28) THEN D=(D+1) MOD 4:BEEP:GOSUB 1000:GOTO 110
160 IF A$<>CHR$(30) THEN 110
170 BEEP:GOSUB 500
180 IF PX=7 AND PY=7 THEN GOTO 4000
190 GOSUB 1000:GOTO 110
500 F=1:IF D=1 THEN F=2
510 IF D=2 THEN F=4
520 IF D=3 THEN F=8
530 IF (C(PX,PY) AND F)=0 THEN RETURN
540 IF D=0 THEN PY=PY-1
550 IF D=1 THEN PX=PX+1
560 IF D=2 THEN PY=PY+1
570 IF D=3 THEN PX=PX-1
580 RETURN
1000 CLS:X=PX:Y=PY
1010 FOR Z=0 TO 2
1020 F=1:LFT=8:RGT=2
1030 IF D=1 THEN F=2:LFT=1:RGT=4
1040 IF D=2 THEN F=4:LFT=2:RGT=8
1050 IF D=3 THEN F=8:LFT=4:RGT=1
1060 IF (C(X,Y) AND LFT)<>0 THEN GOTO 1100
1070 LINE (L(Z),T(Z))-(L(Z+1),T(Z+1)),7
1080 LINE (L(Z),B(Z))-(L(Z+1),B(Z+1)),7
1090 LINE (L(Z+1),T(Z+1))-(L(Z+1),B(Z+1)),7
1100 IF (C(X,Y) AND RGT)<>0 THEN GOTO 1140
1110 LINE (R(Z),T(Z))-(R(Z+1),T(Z+1)),7
1120 LINE (R(Z),B(Z))-(R(Z+1),B(Z+1)),7
1130 LINE (R(Z+1),T(Z+1))-(R(Z+1),B(Z+1)),7
1140 IF (C(X,Y) AND F)<>0 THEN GOTO 1170
1150 LINE (L(Z+1),T(Z+1))-(R(Z+1),B(Z+1)),7,B
1160 GOTO 1220
1170 IF D=0 THEN Y=Y-1
1180 IF D=1 THEN X=X+1
1190 IF D=2 THEN Y=Y+1
1200 IF D=3 THEN X=X-1
1210 NEXT Z
1220 LOCATE 0,22:PRINT "DIRECTION: ";
1230 IF D=0 THEN PRINT "NORTH"
1240 IF D=1 THEN PRINT "EAST"
1250 IF D=2 THEN PRINT "SOUTH"
1260 IF D=3 THEN PRINT "WEST"
1270 LOCATE 0,24:PRINT "ARROWS: TURN/MOVE  SPACE: MAP";
1280 RETURN
2000 FOR Y=0 TO 7:FOR X=0 TO 7:C(X,Y)=0:V(X,Y)=0:NEXT X:NEXT Y
2010 SP=0:X=0:Y=0:V(0,0)=1
2020 N=0
2030 IF Y>0 THEN IF V(X,Y-1)=0 THEN N=N+1:Q(N)=1
2040 IF X<7 THEN IF V(X+1,Y)=0 THEN N=N+1:Q(N)=2
2050 IF Y<7 THEN IF V(X,Y+1)=0 THEN N=N+1:Q(N)=3
2060 IF X>0 THEN IF V(X-1,Y)=0 THEN N=N+1:Q(N)=4
2070 IF N=0 THEN GOTO 2170
2080 J=INT(RND(1)*N)+1:K=Q(J)
2090 SP=SP+1:SX(SP)=X:SY(SP)=Y
2100 IF K=1 THEN C(X,Y)=C(X,Y)+1:Y=Y-1:C(X,Y)=C(X,Y)+4
2110 IF K=2 THEN C(X,Y)=C(X,Y)+2:X=X+1:C(X,Y)=C(X,Y)+8
2120 IF K=3 THEN C(X,Y)=C(X,Y)+4:Y=Y+1:C(X,Y)=C(X,Y)+1
2130 IF K=4 THEN C(X,Y)=C(X,Y)+8:X=X-1:C(X,Y)=C(X,Y)+2
2140 V(X,Y)=1:GOTO 2020
2170 IF SP=0 THEN RETURN
2180 X=SX(SP):Y=SY(SP):SP=SP-1:GOTO 2020
3000 IF M=0 THEN GOSUB 1000:RETURN
3010 CLS:LOCATE 0,0:PRINT "MAP  P=PLAYER  G=GOAL"
3020 FOR Y=0 TO 7
3030 S$=""
3040 FOR X=0 TO 7
3050 S$=S$+"+"
3060 IF (C(X,Y) AND 1)=0 THEN S$=S$+"--" ELSE S$=S$+"  "
3070 NEXT X
3080 S$=S$+"+":PRINT S$
3090 S$=""
3100 FOR X=0 TO 7
3110 IF (C(X,Y) AND 8)=0 THEN S$=S$+"|" ELSE S$=S$+" "
3120 K$="  "
3130 IF X=7 AND Y=7 THEN K$="G "
3140 IF X=PX AND Y=PY THEN K$="P "
3150 S$=S$+K$
3160 NEXT X
3170 IF (C(7,Y) AND 2)=0 THEN S$=S$+"|" ELSE S$=S$+" "
3180 PRINT S$
3190 NEXT Y
3200 S$=""
3210 FOR X=0 TO 7
3220 S$=S$+"+"
3230 IF (C(X,7) AND 4)=0 THEN S$=S$+"--" ELSE S$=S$+"  "
3240 NEXT X
3250 PRINT S$+"+"
3260 LOCATE 0,20:PRINT "SPACE: 3D VIEW";
3270 RETURN
4000 CLS:LOCATE 12,9:PRINT "*** GOAL! ***"
4010 BEEP:BEEP:BEEP
4020 LOCATE 8,11:PRINT "YOU ESCAPED THE MAZE"
4030 END
